# Charset for crawler files. Extensions already select the media type;
# these rules make the charset explicit.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/404.html
  X-Robots-Tag: noindex
